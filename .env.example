# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=eline
POSTGRES_USER=eline
POSTGRES_PASSWORD=eline
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
# Matrices with more rows/columns than this are solved by a Celery worker
SOLVE_ASYNC_THRESHOLD=30
